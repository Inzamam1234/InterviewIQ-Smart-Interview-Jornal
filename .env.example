POSTGRES_DB=interviewjournal
POSTGRES_USER=interviewiq
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-base64-encoded-secret-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:4173
VITE_API_URL=http://localhost:8080

# Keep update for the first deployment against an existing schema. After the
# schema is established and migrations are introduced, prefer validate.
JPA_DDL_AUTO=update
